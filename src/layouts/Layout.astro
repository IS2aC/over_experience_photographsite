---
import { ClientRouter } from 'astro:transitions';
import Loader from '../components/Loader.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import montserrat from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import { CITIES, CONTACT, instagramUrl, tiktokUrl } from '../data/contact';
import { BRAND } from '../data/brand';

interface Props {
  title: string;
  description?: string;
  /** Image de partage (chemin public), 1200×630 */
  image?: string;
}

const {
  title,
  description = `OverXP — Olivier Kouassi, photographe auteur à ${CITIES.replace(' & ', ' et ')} (Côte d'Ivoire). ${BRAND.tagline} : portrait, mode, mariages et événements, la recherche du beau dans chaque pixel.`,
  image = '/og-image.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// Données structurées : studio photo et villes desservies
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'OverXP — Olivier Kouassi',
  slogan: BRAND.tagline,
  description,
  url: Astro.site?.href,
  image: imageUrl.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  email: CONTACT.email,
  telephone: CONTACT.phoneDisplay,
  founder: { '@type': 'Person', name: 'Olivier Kouassi', jobTitle: 'Photographe auteur & directeur artistique' },
  areaServed: CONTACT.cities.map((name) => ({ '@type': 'City', name })),
  address: { '@type': 'PostalAddress', addressLocality: CONTACT.cities[0], addressCountry: 'CI' },
  sameAs: [instagramUrl(CONTACT.instagramPerso), instagramUrl(CONTACT.instagramStudio), tiktokUrl(CONTACT.tiktok)],
};

// Uniquement les icônes utilisées (liste triée exigée par Google Fonts) : police ~10× plus légère
const ICONS =
  'apartment,arrow_back,arrow_downward,arrow_forward,arrow_outward,auto_awesome,auto_stories,award_star,calendar_month,camera,celebration,chat,check_circle,close,diamond,done_all,favorite,flight_takeoff,forward_to_inbox,fullscreen,hub,landscape,light_mode,location_on,mail,mark_email_read,menu,open_in_new,palette,photo_camera,progress_activity,psychology,schedule,school,send,shutter_speed,temple_hindu,verified,view_in_ar,wb_sunny,workspace_premium';
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Icônes -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Partage (Open Graph / Twitter) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="OverXP — Olivier Kouassi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Police préchargée : évite le saut de mise en page au chargement (CLS) -->
    <link rel="preload" href={montserrat} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=${ICONS}&display=block`} rel="stylesheet" />
    <!-- Le loader masque déjà le changement de page : pas d'animation de view transition en plus -->
    <ClientRouter fallback="none" />
  </head>
  <body class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary" transition:animate="none">
    <Loader />
    <SiteHeader />
    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-140px)]">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
