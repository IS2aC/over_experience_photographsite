---
import { Image } from 'astro:assets';
import portrait from '../../assets/home/olivier-kouassi.jpg';
import { CITIES } from '../../data/contact';
---

<section class="relative w-full bg-surface-container-lowest text-text-ivory py-space-2xl px-margin md:px-margin-tablet lg:px-margin-desktop overflow-hidden border-t border-border-gold-subtle scroll-mt-20" id="manifeste">
  <!-- Éclairage d'ambiance darkfield -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-primary/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto flex flex-col gap-space-xl">
    <div class="flex items-center gap-space-sm" data-reveal>
      <div class="w-8 h-px bg-primary"></div>
      <span class="font-label-technical text-label-technical text-primary tracking-[0.35em] uppercase">Manifeste OverXP · 00:01</span>
    </div>

    <div class="flex flex-col gap-space-md" data-reveal>
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-text-ivory">
        « CHAQUE PIXEL, UN HOMMAGE À NOTRE <span class="text-gold-light italic font-normal underline decoration-gold-deep/40 underline-offset-8">CULTURE</span>. »
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mt-space-sm">
        Chez OverXP, la photographie n'est pas une simple captation mécanique du réel. C'est une architecture lumineuse sculptée au millimètre près, un dialogue intime entre les mémoires ancestrales Akan, la dignité royale des cours africaines et la rigueur contemporaine de l'optique de pointe.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter-desktop items-center pt-space-lg border-t border-track-subtle" data-reveal>
      <div class="md:col-span-4 flex items-center gap-space-md">
        <div class="w-16 h-16 rounded-full overflow-hidden bg-surface-raised border border-border-gold-active shrink-0">
          <Image src={portrait} alt="Olivier Kouassi, directeur créatif OverXP" width={128} height={128} class="w-full h-full object-cover object-top grayscale contrast-125" />
        </div>
        <div class="flex flex-col">
          <span class="font-title-md text-title-md text-text-ivory font-bold">Olivier Kouassi</span>
          <span class="font-label-timecode text-label-timecode text-primary tracking-[0.2em] uppercase">Directeur artistique &amp; fondateur</span>
          <span class="font-label-timecode text-[11px] text-outline tracking-wider uppercase">Ambassadeur officiel · {CITIES}</span>
        </div>
      </div>
      <div class="md:col-span-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-md bg-surface-warm/80 p-space-md rounded-DEFAULT border border-border-gold-subtle">
        <div class="flex flex-col">
          <span class="font-label-technical text-label-technical text-gold-light tracking-[0.25em] uppercase">Approche singulière</span>
          <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">« Nous fusionnons la haute joaillerie du regard photographique avec la puissance narrative panafricaine. »</p>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-2xl">verified</span>
          <span class="font-label-timecode text-label-timecode text-text-ivory tracking-[0.2em]">CERTIFIÉ OVERXP</span>
        </div>
      </div>
    </div>
  </div>
</section>
