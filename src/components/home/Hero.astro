---
import { Image } from 'astro:assets';
import emblem from '../../assets/overxp-emblem.png';
import { CITIES } from '../../data/contact';

const annotations = [
  { n: '01', title: 'La lumière', text: 'Prisme optique & capteur plein format calibré.', short: 'Prisme optique & capteur plein format.', meta: 'EXIF REF: 50MM · F/1.2 S · 1/8000S', color: 'primary' },
  { n: '02', title: 'Le regard', text: 'Diaphragme de haute précision et focus sélectif.', short: 'Diaphragme de précision chirurgicale.', meta: 'ANAMORPHIC DEPTH FIELD', color: 'secondary-container' },
  { n: '03', title: 'La culture', text: 'Héritage Akan, chromaticité terracotta & géométrie sacrée.', short: 'Héritage Akan & géométrie sacrée.', color: 'primary-container' },
] as const;

const accent = {
  primary: { text: 'text-primary', border: 'border-primary' },
  'secondary-container': { text: 'text-secondary-container', border: 'border-secondary-container' },
  'primary-container': { text: 'text-primary-container', border: 'border-primary-container' },
};
---

<!-- Section épinglée pendant la décomposition de l'appareil (src/scripts/sequence.ts) -->
<section class="hero-pin relative w-full bg-studio-white text-surface-container-lowest overflow-hidden">
  <!-- Trame de points d'ingénierie optique -->
  <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image: radial-gradient(circle, #0e0e0e 1px, transparent 1px); background-size: 32px 32px;"></div>

  <!-- Pas de z-index ici ni autour de l'image : le mix-blend-multiply doit voir la trame de fond -->
  <!-- Hauteur = écran sous le header : tout reste visible pendant l'épinglage -->
  <div class="relative w-full px-margin md:px-margin-tablet lg:px-margin-desktop py-space-md md:py-space-lg flex flex-col h-[calc(100svh-5rem)] min-h-[560px]">
    <!-- Identité -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-space-sm md:gap-space-md border-b border-surface-container-lowest/10 pb-space-sm md:pb-space-md shrink-0" data-reveal>
      <div class="flex flex-col gap-space-xs">
        <div class="flex items-center gap-space-sm">
          <span class="inline-block w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
          <span class="font-label-technical text-label-technical tracking-[0.35em] text-surface-container-highest uppercase font-bold">
            Olivier Kouassi · Photographe auteur · {CITIES}
          </span>
        </div>
        <span class="hidden sm:block font-label-timecode text-label-timecode text-outline tracking-[0.25em] uppercase">
          Studio OverXP · Côte d'Ivoire · Coordonnées 5.3599° N, 4.0083° W
        </span>
      </div>
      <div class="flex items-center gap-space-sm self-start md:self-auto bg-surface-container-lowest/5 px-space-md py-space-xs rounded-DEFAULT border border-surface-container-lowest/10">
        <Image src={emblem} alt="" width={96} height={96} loading="eager" class="w-10 h-10 shrink-0 object-contain" />
        <div class="flex flex-col">
          <span class="font-label-technical text-label-technical text-surface-container-lowest tracking-[0.3em] font-extrabold">OVERXP</span>
          <span class="font-label-timecode text-label-timecode text-outline tracking-[0.18em] -mt-1">INGÉNIERIE OPTIQUE</span>
        </div>
      </div>
    </div>

    <!-- Titre monumental + vue éclatée -->
    <div class="flex-1 min-h-0 pt-space-md flex flex-col items-center text-center relative">
      <div class="max-w-5xl mx-auto z-20 flex flex-col items-center shrink-0" data-reveal>
        <div class="inline-flex items-center gap-space-xs px-3 py-1 bg-surface-container-lowest text-text-ivory rounded-DEFAULT mb-space-sm">
          <span class="material-symbols-outlined text-sm text-primary">view_in_ar</span>
          <span class="font-label-timecode text-label-timecode tracking-[0.3em] uppercase">Mécanique de précision photographique</span>
        </div>
        <h1 class="font-display-xl text-display-xl-mobile md:text-display-xl text-surface-container-lowest uppercase font-extrabold select-none leading-none">
          Over Experience
        </h1>
        <p class="font-label-technical text-label-technical md:text-sm text-primary-container tracking-[0.35em] uppercase font-bold mt-space-xs">
          Ingénierie visuelle &amp; art photographique
        </p>
      </div>

      <div class="relative w-full max-w-5xl flex-1 min-h-0 my-space-sm flex items-center justify-center">
        <div class="relative w-full h-full flex items-center justify-center">
          <!-- Séquence image par image : l'appareil se décompose au scroll et se recompose en remontant -->
          <canvas
            class="hero-camera w-full h-full object-contain mix-blend-multiply"
            width="1280"
            height="720"
            role="img"
            aria-label="Appareil photo qui se décompose pièce par pièce en vue éclatée — Studio OverXP, Olivier Kouassi"
            data-frame-sequence></canvas>
          <noscript>
            <img src="/frames/1280/072.webp" alt="Vue éclatée d'un appareil photo — Studio OverXP" class="absolute inset-0 w-full h-full object-contain mix-blend-multiply" />
          </noscript>

          <!-- Annotations (desktop) -->
          {
            annotations.map((a, i) => (
              <div
                class:list={[
                  'hero-note hidden lg:flex flex-col absolute max-w-xs bg-studio-white/90 backdrop-blur-md p-space-sm rounded-DEFAULT shadow-sm',
                  accent[a.color].border,
                  i === 0 && 'text-left -left-4 top-1/4 border-l-2',
                  i === 1 && 'text-right -right-4 top-1/3 border-r-2',
                  i === 2 && 'text-left left-1/4 bottom-0 max-w-sm bg-studio-white/95 border-b-2',
                ]}
              >
                <span class:list={['font-label-technical text-label-technical font-bold tracking-[0.25em] uppercase', accent[a.color].text]}>
                  {a.n} — {a.title}
                </span>
                <span class="font-body-sm text-body-sm text-surface-container-highest font-medium mt-0.5">{a.text}</span>
                {'meta' in a && <span class="font-label-timecode text-[10px] text-outline tracking-widest mt-1">{a.meta}</span>}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Annotations (mobile / tablette) -->
      <div class="grid lg:hidden grid-cols-3 gap-space-xs sm:gap-space-sm w-full shrink-0 text-left">
        {
          annotations.map((a) => (
            <div class:list={['p-space-xs sm:p-space-sm bg-surface-container-lowest/5 rounded-DEFAULT border-l-2', accent[a.color].border]}>
              <span class:list={['font-label-technical text-[10px] sm:text-label-technical font-bold tracking-[0.15em] sm:tracking-[0.2em] block uppercase', accent[a.color].text]}>
                {a.n} — {a.title}
              </span>
              <span class="hidden sm:block font-body-sm text-body-sm text-surface-container-highest">{a.short}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bas de hero -->
    <div class="pt-space-sm md:pt-space-md border-t border-surface-container-lowest/10 flex flex-col sm:flex-row items-center justify-between gap-space-sm md:gap-space-md shrink-0" data-reveal>
      <div class="flex flex-col sm:flex-row items-center gap-space-md">
        <a class="px-space-md py-2.5 bg-surface-container-lowest text-text-ivory font-label-technical text-label-technical tracking-[0.25em] uppercase hover:bg-gold-deep transition-all shadow-md" href="/reserver">
          Commissionner une session
        </a>
        <a class="hidden sm:inline font-label-technical text-label-technical text-surface-container-highest hover:text-surface-container-lowest tracking-[0.25em] uppercase transition-colors" href="#manifeste">
          Découvrir le manifeste
        </a>
      </div>
      <span class="hidden md:inline font-label-timecode text-label-timecode text-outline tracking-[0.25em] uppercase tabular-nums" aria-hidden="true">
        Décomposition <span class="text-primary-container" data-sequence-progress>00</span>%
      </span>
      <a class="group flex items-center gap-space-xs text-surface-container-lowest" href="#manifeste">
        <span class="font-label-technical text-label-technical tracking-[0.3em] uppercase group-hover:text-primary-container transition-colors">Défiler</span>
        <span class="material-symbols-outlined text-lg animate-bounce text-primary-container">arrow_downward</span>
      </a>
    </div>
  </div>
</section>
