---
import Layout from '../layouts/Layout.astro';
import ContactIntro from '../components/contact/ContactIntro.astro';
import Channels from '../components/contact/Channels.astro';
import BookingInvite from '../components/contact/BookingInvite.astro';
---

<Layout title="Contact · Olivier Kouassi | OverXP" description="Contacter Olivier Kouassi, photographe auteur à Abidjan et Bouaké : WhatsApp, e-mail, Instagram et demandes de tirages d'art.">
  <div class="relative w-full overflow-hidden">
    <!-- Lumière de softbox d'ambiance -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-gradient-to-b from-primary/10 via-gold-deep/5 to-transparent blur-3xl opacity-70"></div>
    <div class="pointer-events-none absolute top-[40%] -right-48 w-[500px] h-[500px] bg-gold-deep/10 blur-[130px] rounded-full"></div>

    <div class="relative w-full px-margin md:px-margin-tablet lg:px-margin-desktop py-space-xl lg:py-space-2xl flex flex-col gap-space-2xl">
      <ContactIntro />
      <Channels />
      <BookingInvite />
    </div>
  </div>
</Layout>

<script>
  import '../scripts/contact';
</script>
